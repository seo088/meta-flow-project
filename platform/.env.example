# === 프로젝트 ===
COMPOSE_PROJECT_NAME=meta-plogging
ENVIRONMENT=development

# === 서버 IP (localhost 대신 고정 IP 사용) ===
SERVER_HOST=203.234.62.176

# === PostgreSQL (기존 :5432 사용 중 → :5433) ===
POSTGRES_HOST=203.234.62.176
POSTGRES_PORT=5433
POSTGRES_USER=plogging
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=plogging_db
DATABASE_URL=postgresql://plogging:your_password_here@203.234.62.176:5433/plogging_db

# === Redis (→ :6380) ===
REDIS_HOST=203.234.62.176
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password

# === Kafka (→ :9093) ===
KAFKA_BOOTSTRAP_SERVERS=203.234.62.176:9093

# === MinIO (→ :9001/:9002) ===
MINIO_ENDPOINT=203.234.62.176:9001
MINIO_ACCESS_KEY=plogging_admin
MINIO_SECRET_KEY=your_minio_secret
MINIO_BUCKET_IMAGES=plogging-images
MINIO_BUCKET_VIDEOS=plogging-videos

# === Elasticsearch (기존 :9200 사용 중 → :9201) ===
ES_HOST=203.234.62.176
ES_PORT=9201

# === JWT ===
JWT_SECRET_KEY=your_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=1440

# === FastAPI 서비스 포트 (85xx 대역) ===
GATEWAY_PORT=8500
SNS_PORT=8501
GAME_PORT=8502
GIS_PORT=8503
AI_PORT=8504
DATA_PORT=8505
MCP_PORT=8510
WS_PORT=8520

# === Agent 포트 ===
DRONE_AGENT_PORT=8531
DATA_AGENT_PORT=8532
MOBILITY_AGENT_PORT=8533

# === AI ===
AI_MODE=dummy
TORCHSERVE_HOST=203.234.62.176
TORCHSERVE_PORT=7070
YOLO_MODEL_NAME=yolo_plogging_v8
VERIFY_MODEL_NAME=cleanup_verify_v1
GPU_DEVICE=cuda:0

# === MCP ===
MCP_SERVER_URL=http://203.234.62.176:8510/sse

# === 내부 서비스 URL ===
AI_SERVICE_URL=http://203.234.62.176:8504
SNS_SERVICE_URL=http://203.234.62.176:8501
GAME_SERVICE_URL=http://203.234.62.176:8502
GIS_SERVICE_URL=http://203.234.62.176:8503
DATA_SERVICE_URL=http://203.234.62.176:8505
WS_SERVICE_URL=http://203.234.62.176:8520

# === 모니터링 ===
GRAFANA_ADMIN_PASSWORD=your_grafana_password


# GitLab
GITLAB_URL=https://203.234.62.175:5443
GITLAB_USER=jwon
GITLAB_TOKEN=your_gitlab_token
