# ═══════════════════════════════════════════════════════════
# Meta SW 플로깅 — Docker 배포용 환경 변수 템플릿
# ═══════════════════════════════════════════════════════════
# 사용법 (맥/리눅스 공통):
#   cd platform
#   cp .env.docker.example .env
#   # ↓ [REQUIRED] 항목 채우기
#   docker compose up -d --build
#
# 시크릿 생성 권장:
#   openssl rand -hex 32   # JWT_SECRET_KEY / 비밀번호용
# ═══════════════════════════════════════════════════════════

# === 프로젝트 ===
COMPOSE_PROJECT_NAME=meta-plogging
ENVIRONMENT=development
SERVER_HOST=0.0.0.0

# === PostgreSQL [REQUIRED] ===
# 컨테이너 간 통신: postgres / 호스트→컨테이너: localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_USER=plogging
POSTGRES_PASSWORD=change_me_pg_password
POSTGRES_DB=plogging
DATABASE_URL=postgresql://plogging:change_me_pg_password@postgres:5432/plogging

# === Redis [REQUIRED] ===
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=change_me_redis_password

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9093

# === MinIO 객체 스토리지 [REQUIRED] ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=plogging_admin
MINIO_SECRET_KEY=change_me_minio_secret_min8
MINIO_BUCKET_IMAGES=plogging-images
MINIO_BUCKET_VIDEOS=plogging-videos
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
# 브라우저가 접근할 URL — 맥/로컬에서는 localhost 그대로 OK
# 원격 서버 배포 시: http://<server-ip>:9001
# ⚠️ Synology NAS 등 원격 배포 [REQUIRED]: 반드시 NAS 실제 IP/도메인으로 변경
#    (localhost로 두면 외부 기기 접속 시 업로드 이미지가 전부 깨짐)
#    예) http://192.168.0.10:9001  또는  https://nas.example.com:9001
MINIO_PUBLIC_URL=http://localhost:9001

# === Elasticsearch (선택 — `docker compose --profile search up`) ===
ES_HOST=elasticsearch
ES_PORT=9201

# === JWT [REQUIRED] ===
# openssl rand -hex 32 결과를 붙여넣으세요
JWT_SECRET_KEY=change_to_random_32_byte_hex_string_for_security
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=1440

# === 서비스 포트 (호스트에 노출) ===
GATEWAY_PORT=8500
SNS_PORT=8501
GAME_PORT=8502
GIS_PORT=8503
AI_PORT=8504
DATA_PORT=8505
MCP_PORT=8510

# === AI 서비스 모드 ===
# dummy: 가벼운 모드(권장, ML 의존성 없음)
# real:  torch/ultralytics 필요 (Dockerfile에 ai 빌드 단계 추가 필요)
AI_MODE=dummy

# === Gemini API (이모지 추천 — 선택) ===
# 없으면 키워드 기반 폴백 자동 사용
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# === 내부 서비스 URL (게이트웨이 → 다른 서비스) ===
# Docker 네트워크 내 호스트명 사용 (변경 불필요)
AI_SERVICE_URL=http://ai:8504
SNS_SERVICE_URL=http://sns:8501
GAME_SERVICE_URL=http://game:8502
GIS_SERVICE_URL=http://gis:8503
MCP_SERVICE_URL=http://mcp:8510
